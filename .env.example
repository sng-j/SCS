# SCS — environment variables template
# Copy this file to `.env.local` (runtime) and `.env` (Prisma CLI),
# then fill in real values. Both files are gitignored.

# ── Database ──────────────────────────────────────────────────────────
# MySQL connection string (local Docker default uses port 3307 to avoid
# conflict with a host-installed MySQL on 3306). Format:
#   mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="mysql://scs:CHANGE_ME@localhost:3307/scs_db"

# ── App host (LAN development) ────────────────────────────────────────
# Host name used when accessing the dev server from other devices on
# the LAN. Required so Next.js allows cross-origin dev resources (HMR).
# In production, set this to the public hostname.
APP_HOST="192.168.100.22"

# ── NextAuth ──────────────────────────────────────────────────────────
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# When true, NextAuth trusts the Host header instead of requiring a
# fixed AUTH_URL. Keep true for LAN/multi-host development.
AUTH_TRUST_HOST=true

# Only needed if you want to hardcode the callback URL (rare).
# AUTH_URL="https://scs.example.com"

# ── LLM / AI (optional) ───────────────────────────────────────────────
# Set these to enable the AI assistant orchestrator. Leave blank to run
# in rule-based fallback mode.
LLM_API_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Anthropic API key — used by the document AI-assist endpoint.
ANTHROPIC_API_KEY=""

# ── Uploads (optional) ────────────────────────────────────────────────
# Defaults to ./uploads when unset. Override to use a mounted volume.
# UPLOAD_DIR="/mnt/data/uploads"
